<html lang="en">
  <%- include("./partials/head.ejs")%>
  <body>
    <%- include("./partials/header.ejs")%>

    <h1>Timeline</h1>
    <div class="input-data">
      <form method="post" action="/add-post">
        <label for="userName">Post a message</label>
        <input type="text" name="userName" placeholder="userName" />
        <label for="userMessage">Post a message</label>
        <textarea name="userMessage"></textarea>
        <button class="btn">Post a message</button>
      </form>
    </div>

    <div class="post-data">
      <% if (data.length > 0){ %> <% data.forEach (data => { %>
      <div class="post-item">
        <h3 class="name"><%= data.userName%></h3>
        <span class="date">- <%= data.createdAt%></span>
        <p class="message"><%= data.userMessage%></p>
      </div>

      <%}) %> <% } %>
    </div>
  </body>
</html>
