<html lang="en">
  <%- include("./partials/head.ejs")%>
  <body>
    <%- include("./partials/header.ejs")%>
    <div>
      <h1>Timeline</h1>

      <form class="input-data" method="post" action="/add-post">
        <label for="userName">Post a message</label>
        <input type="text" name="userName" placeholder="Your Name..." />

        <textarea name="userMessage"></textarea>
        <button class="btn post">Post a message</button>
      </form>

      <div class="post-data">
        <% if (data && data.length > 0) { %> <% data.forEach (data => { %>
        <div class="post-item">
          <h3 class="name"><%= data.userName%></h3>
          <span class="date">- <%= data.createdAt%></span>
          <p class="message"><%= data.userMessage%></p>
        </div>

        <%}) %> <% } else { %>
        <p>There are no messages. Be the first to post something!</p>
        <% }%>
      </div>

      <!-- <form class="input-data" method="post" action="/add-comment">
        <input
          type="text"
          name="userComment"
          placeholder=" Your comment here..."
          autocomplete="off"
        />
        <button class="btn post">Post a comment</button>
      </form> -->

      <!-- <div class="post-data">
        <% if (data.length > 0){ %> <% data.forEach (data => { %>
        <div class="post-item">
          <h3 class="name"><%= data.userComment%></h3>
        </div>

        <%}) %>
      </div> -->
    </div>
  </body>
</html>
